---
interface Props { url: string; }
const { url } = Astro.props;
---
<div style="margin: 3rem 0;">
  <iframe
    width="100%"
    height="166"
    scrolling="no"
    frameborder="no"
    allow="autoplay"
    src={`https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&color=%239caf88&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false`}>
  </iframe>
</div>
